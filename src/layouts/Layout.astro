---
import "../styles/global.css";
import { profile } from "../data/site";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  /** wide container for the home page; case studies keep the narrow reading width */
  wide?: boolean;
  /** "article" for case studies */
  ogType?: "website" | "article";
  /** keep the page out of search results (404) */
  noindex?: boolean;
  /** emit Person structured data (home page only) */
  person?: boolean;
  /** extra structured data for this page, e.g. an Article for a case study */
  schema?: Record<string, unknown>;
}
const { title, description = profile.description, wide = false, ogType = "website", noindex = false, person = false, schema } =
  Astro.props;
const container = wide ? "max-w-5xl" : "max-w-3xl";
const fullTitle = title ? `${title} · ${profile.name}` : profile.seoTitle;
const origin = Astro.site ?? Astro.url.origin;
const ogImage = new URL("/og.png", origin).href;

// tells search engines who this is and ties the site to LinkedIn and GitHub
const jsonLd = person && {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.title,
    url: new URL("/", origin).href,
    image: ogImage,
    email: `mailto:${profile.email}`,
    worksFor: { "@type": "Organization", name: profile.org.name, url: profile.org.url },
    address: { "@type": "PostalAddress", addressLocality: "New York", addressRegion: "NY", addressCountry: "US" },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "University at Buffalo" },
      { "@type": "CollegeOrUniversity", name: "National Institute of Technology Durgapur" },
    ],
    knowsAbout: ["LLM agents", "AI engineering", "Retrieval-augmented generation", "LLM evaluation", "Tool calling", "Voice AI agents", "Claude", "Amazon Bedrock", "Python", "AWS", "Reinforcement learning"],
    sameAs: [profile.linkedin, profile.github],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={Astro.url.href} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <meta name="theme-color" content="#0a0e0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // apply a saved theme choice before first paint, so there is no flash
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-exploit focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-ink"
      >Skip to content</a
    >
    <nav class="sticky top-0 z-20 bg-ink/85 backdrop-blur border-b border-grid/60">
      <div class:list={["mx-auto px-5 h-14 flex items-center justify-between", container]}>
        <a href="/" class="font-serif font-semibold text-[17px] text-text no-underline">{profile.name}</a>
        <ul class="flex gap-6 text-sm text-muted">
          <li class="hidden sm:block"><a class="hover:text-text" href="/#about">About</a></li>
          <li class="hidden sm:block"><a class="hover:text-text" href="/#projects">Projects</a></li>
          <li class="hidden sm:block"><a class="hover:text-text" href="/#essay">Essay</a></li>
          <li><a class="text-text sm:text-muted hover:text-text" href="/#contact">Contact</a></li>
          <li class="flex items-center">
            <button
              id="theme-toggle"
              type="button"
              class="theme-toggle -m-1.5 p-1.5 rounded-md text-muted hover:text-text cursor-pointer"
              aria-label="Switch between light and dark mode"
              title="Switch between light and dark mode"
            >
              <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
              <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            </button>
          </li>
        </ul>
      </div>
    </nav>
    <slot />
    <script>
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        const next = current === "light" ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
    <footer class="border-t border-grid">
      <div class:list={["mx-auto px-5 py-6 flex flex-wrap justify-between gap-3 font-mono text-xs text-muted", container]}>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <a class="hover:text-text" href="https://github.com/thanoojrao/portfolio">source</a>
      </div>
    </footer>
  </body>
</html>
