---
import { brief, experience } from "../data/site";
// the first three entries show; the rest sit behind "Show more"
const shown = 3;
const short: Record<string, string> = {
  Dottr: "Agent loop, honesty guard, eval harness, signature-field detection, AWS.",
  "University at Buffalo": "Reinforcement learning, ML, NLP, computer vision.",
  "Tata Consultancy Services": "RAG claims pre-audit tool for insurers, used by 10K+ people.",
  Counselit: "Node/Express APIs and React interfaces for client pilots.",
  "NIT Durgapur": "Robocell, the robotics club.",
};
// newest first, work and school interleaved by start date
const order = ["Dottr", "University at Buffalo", "Tata Consultancy Services", "Counselit", "NIT Durgapur"];
const timeline = order.map((o) => experience.find((e) => e.org === o)!).filter(Boolean);
---

<section id="about" class="measure py-14 border-t border-grid scroll-mt-14">
  <h2 class="h2">About</h2>
  {brief.paragraphs.map((p) => <p class="mb-4">{p}</p>)}
  <div class="mt-7 grid grid-cols-1 sm:grid-cols-3 gap-px bg-grid border border-grid rounded-[10px] overflow-hidden">
    {
      brief.stats.map((s) => (
        <a
          href={`/projects/${s.slug}/`}
          class="group relative block bg-ink px-[18px] py-4 no-underline transition-colors duration-200 hover:bg-panel focus-visible:bg-panel focus-visible:outline-none"
        >
          <b class="block font-serif font-semibold text-[22px] leading-tight text-text transition-colors duration-200 group-hover:text-exploit group-focus-visible:text-exploit">
            {s.value}
          </b>
          <span class="block mt-1 pr-5 text-[13px] leading-snug text-muted transition-colors duration-200 group-hover:text-body">
            {s.label}
          </span>
          <span
            class="absolute right-4 top-4 text-exploit opacity-0 -translate-x-1 transition duration-200 group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0"
            aria-hidden="true">→</span
          >
          <span class="absolute inset-x-0 bottom-0 h-px bg-exploit scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100 group-focus-visible:scale-x-100"></span>
        </a>
      ))
    }
  </div>
  <h3 class="mt-7 mb-1.5 font-mono text-xs font-medium tracking-wider uppercase text-exploit">Skills</h3>
  <p class="text-[15px] leading-relaxed text-text">
    {
      brief.skills.map((s, i) => (
        <>
          {i > 0 && <span class="text-muted"> · </span>}
          {s}
        </>
      ))
    }
  </p>
</section>

<section id="timeline" class="measure py-14 border-t border-grid">
  <h2 class="h2">Timeline</h2>
  <ul id="tl" class="divide-y divide-dashed divide-grid">
    {
      timeline.map((e, i) => (
        <li class:list={["grid-cols-1 sm:grid-cols-[150px_1fr] gap-x-5 gap-y-0.5 py-3.5", i < shown ? "grid" : "hidden extra"]}>
          <div class="font-mono text-[13px] leading-[1.9] text-muted">{e.period.replace(" — ", " – ").replace("present", "now")}</div>
          <div class="text-text font-medium">
            {e.role} · {e.org}
            <small class="block font-normal text-sm leading-relaxed text-muted mt-0.5">{short[e.org] ?? e.lines[0]}</small>
          </div>
        </li>
      ))
    }
  </ul>
  <button id="tl-more" class="mt-2.5 font-mono text-[13px] text-muted hover:text-text cursor-pointer" aria-expanded="false" aria-controls="tl">
    Show more ↓
  </button>
</section>

<script>
  const btn = document.getElementById("tl-more");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    btn.textContent = open ? "Show less ↑" : "Show more ↓";
    document.querySelectorAll("#tl .extra").forEach((el) => {
      el.classList.toggle("hidden", !open);
      el.classList.toggle("grid", open);
    });
  });
</script>
