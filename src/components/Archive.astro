---
import { alsoPulled } from "../data/site";
---

<section class="mx-auto max-w-6xl px-4 md:px-8 pb-6 reveal">
  <div class="prompt text-sm md:text-base">
    <span class="text-text">$</span> ls projects/archive/ <span class="text-muted">--oneline</span>
  </div>
  <ul class="mt-4 space-y-2 text-sm">
    {
      alsoPulled.map((p, i) => (
        <li class="flex flex-wrap gap-x-3 gap-y-0.5 text-muted">
          <span class="text-muted/60 shrink-0">[{String(i).padStart(2, "0")}]</span>
          {p.href ? (
            <a class="u text-text shrink-0" href={p.href} target="_blank" rel="noreferrer">
              {p.title}
            </a>
          ) : (
            <span class="text-text shrink-0">{p.title}</span>
          )}
          <span class="text-muted/80">— {p.note}</span>
        </li>
      ))
    }
  </ul>
</section>
