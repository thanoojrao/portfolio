---
import Section from "./Section.astro";
import { profile } from "../data/site";

const links = [
  { k: "email", label: profile.email, href: `mailto:${profile.email}` },
  { k: "github", label: "github.com/thanoojrao", href: profile.github },
  { k: "linkedin", label: "linkedin.com/in/thanooj-lingampally", href: profile.linkedin },
  ...(profile.resume ? [{ k: "resume", label: "resume.pdf", href: profile.resume }] : []),
];
---

<Section id="contact" cmd="ping" args="thanooj">
  <p class="text-muted max-w-xl">
    Open to conversations about production agents, evals, and anything with a robot in it. Reply time is usually within a
    day.
  </p>
  <ul class="mt-6 space-y-2 text-sm">
    {
      links.map((l) => (
        <li class="flex flex-wrap gap-x-3">
          <span class="text-muted w-20 shrink-0">{l.k}:</span>
          <a class="u" href={l.href} target={l.href.startsWith("mailto") ? undefined : "_blank"} rel="noreferrer">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-8 text-xs text-muted/70">
    64 bytes from thanooj: icmp_seq=1 ttl=64 time=<span class="accent">0.9 ms</span>
  </div>
</Section>
