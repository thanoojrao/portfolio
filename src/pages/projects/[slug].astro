---
import Layout from "../../layouts/Layout.astro";
import { projects, profile } from "../../data/site";
import HonestyGuard from "../../components/HonestyGuard";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
// "next" stays within the same track: Work leads to Work, Experiments to Experiments
const siblings = projects.filter((p) => p.track === project.track);
const idx = siblings.findIndex((p) => p.slug === project.slug);
const next = siblings[(idx + 1) % siblings.length];
---

<Layout title={project.seoTitle} description={project.metaDescription} ogType="article">
  <main id="main" class="mx-auto max-w-3xl px-5 pt-10 md:pt-14 pb-10">
    <nav class="text-sm text-muted">
      <a class="hover:text-text" href="/#projects">← All projects</a>
    </nav>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-muted">
        <span class={project.track === "work" ? "text-exploit" : "text-explore"}>
          {project.track === "work" ? "Work" : "Experiment"}
        </span>
        {project.org && <span>· {project.org}</span>}
        <span>· {project.period}</span>
      </div>
      <h1 class="mt-3 font-serif font-semibold text-text text-[30px] md:text-[40px] leading-[1.15] tracking-[-0.01em]">{project.title}</h1>
      <p class="mt-4 text-[17px] leading-relaxed">{project.summary}</p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        {project.chips.map((c) => <span class:list={["chip", project.track === "experiment" && "amber"]}>{c}</span>)}
        {
          project.tags.map((t) => (
            <span class="font-mono text-[11px] px-2 py-0.5 rounded-md panel text-muted">{t}</span>
          ))
        }
      </div>
      {
        project.links.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-4 text-sm">
            {project.links.map((l) => (
              <a class="u" href={l.href} target="_blank" rel="noreferrer">
                {l.label} ↗
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      project.demo === "honesty-guard" && (
        <section class="mt-10">
          <h2 class="font-serif font-semibold text-text text-[22px]">Live replay: the honesty guard</h2>
          <p class="mt-2 text-[15px] text-muted">
            The reply streams right away. The guard reads it as it arrives and checks every claim against records the system
            owns. A claim with no record behind it is struck out and corrected.
          </p>
          <div class="mt-4">
            <HonestyGuard client:visible />
          </div>
          <p class="mt-2 text-[13px] text-muted">Simulated: names and data are invented and the timing is slowed so it can be read.</p>
        </section>
      )
    }

    <article class="mt-10 space-y-9">
      {
        project.sections.map((s) => (
          <section>
            <h2 class="font-serif font-semibold text-text text-[22px]">{s.heading}</h2>
            <div class="mt-3 space-y-3 leading-relaxed">
              {s.body.length > 1 ? (
                <ul class="space-y-2">
                  {s.body.map((b) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.7em] size-1.5 shrink-0 rounded-full bg-muted" aria-hidden="true"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                s.body.map((b) => <p>{b}</p>)
              )}
            </div>
          </section>
        ))
      }
    </article>

    <aside class="mt-14 p-6 rounded-xl panel">
      <p class="font-serif font-semibold text-text text-[22px] leading-snug">Building something like this?</p>
      <p class="mt-1.5 text-[15px] text-muted">I'd like to hear about it. I usually reply within a day.</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-1 gap-y-2 text-sm">
        <a
          class="inline-flex items-center gap-2 rounded-lg bg-exploit text-[#06120b] font-medium px-[18px] py-2.5 mr-2 hover:brightness-110"
          href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">→</span></a
        >
        {profile.resume && <a class="px-3 py-2.5 text-body hover:text-text" href={profile.resume}>Résumé</a>}
        <a class="px-3 py-2.5 text-body hover:text-text" href={profile.linkedin}>LinkedIn</a>
      </div>
    </aside>

    {
      next.slug !== project.slug && (
        <nav class="mt-10 pt-6 border-t border-grid flex justify-between gap-4 text-sm" aria-label="More projects">
          <a class="text-muted hover:text-text" href="/#projects">← All projects</a>
          <a class="text-right text-muted hover:text-text" href={`/projects/${next.slug}/`}>
            <span class="block font-mono text-xs">Next {project.track === "work" ? "case study" : "write-up"}</span>
            <span class="text-text">{next.title}</span> <span aria-hidden="true">→</span>
          </a>
        </nav>
      )
    }
  </main>
</Layout>
