---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/site";
---

<Layout title="Page not found" noindex>
  <main id="main" class="mx-auto max-w-3xl px-5 pt-24 md:pt-32 pb-24">
    <p class="font-mono text-xs text-muted">404</p>
    <h1 class="mt-3 font-serif font-semibold text-text text-[34px] md:text-[44px] leading-tight">Page not found</h1>
    <p class="mt-4 text-[17px] max-w-xl">Nothing lives at this address. It may have moved, or the link may be mistyped.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-1 gap-y-2 text-sm">
      <a class="inline-flex items-center rounded-lg bg-exploit text-[#06120b] font-medium px-[18px] py-2.5 mr-2 hover:brightness-110" href="/"
        ><span aria-hidden="true">←&nbsp;</span>Home</a
      >
      <a class="px-3 py-2.5 text-body hover:text-text" href="/#projects">Projects</a>
      <a class="px-3 py-2.5 text-body hover:text-text" href={`mailto:${profile.email}`}>Email me</a>
    </div>
  </main>
</Layout>
